#!/bin/sh
set -eu

LABEL="com.dragco.mk1-bridge"

console_user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -z "${console_user}" ] || [ "${console_user}" = "root" ] || [ "${console_user}" = "loginwindow" ]; then
    exit 0
fi

console_uid="$(id -u "${console_user}" 2>/dev/null || true)"
if [ -z "${console_uid}" ]; then
    exit 0
fi

# Stop the bridge daemon before the installer overwrites the app bundle.
# The binary now lives inside MK1 Revive.app, so macOS will block the
# payload copy if the process is still running.
# Use the label-based form so it works regardless of where the plist lives.
launchctl bootout "gui/${console_uid}/${LABEL}" >/dev/null 2>&1 || true

# Also stop the menu bar app — it holds the app bundle open.
pkill -x mk1-menubar >/dev/null 2>&1 || true

# Give processes a moment to exit before the installer copies the new bundle.
sleep 1

exit 0
